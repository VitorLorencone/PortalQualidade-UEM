<?xml version="1.0" encoding="UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul" xmlns:n="native" xmlns:w="client" xmlns:ca="client/attribute">

    <nodom title="" id="winEnvioEmail" use="controller.envioEmails.EnvioEmailsController">
        <div id="titulo-envio-mensages" class="d-flex pb-4">
            <div class="col">
                <n:h4>Envio de Mensagens por Email</n:h4>
            </div>
            <div class="col text-end">
                <button label="Escolher Mensagem" iconSclass="z-icon-plus" 
                    onClick="winEnvioEmail.escolherMensagem()" class="btn btn-primary"/>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <!-- Parte com botões. A classe justify-content-between fará com que os botões fiquem justificados -->
                <div class="d-flex justify-content-between form-group mb-3">
                    <div class="col-sm-12 col-md-12 col-lg-10 pl-0">
                        <div class="row"> 
                            <div class="col-md-3"> 
                                <div class="input-group">
                                    <textbox id="vlPesquisa" class="form-control" 
                                        placeholder="Buscar documentos...">
                                        <attribute name="onOK">
                                <![CDATA[
                                    winEnvioEmail.filtrar();
                                ]]>
                                        </attribute>
                                    </textbox>        
                                    <button label="Filtrar" class="btn btn-light btn-outline-secondary" 
                                        iconSclass="z-icon-search" onClick="winEnvioEmail.filtrar()"/>
                                </div>
                            </div>
                            <div class="col-md-3">                
                                <listbox id="vlCampo" mold="select" class="form-select">
                                    <listitem value="" selected="true">
                                        <listcell label="Todos os campos"/>
                                    </listitem>
                                    <listitem value="nome">
                                        <listcell label="Nome"/>
                                    </listitem>
                                    <listitem value="descricao">
                                        <listcell label="Descrição"/>
                                    </listitem>
                                </listbox>
                            </div>
                            <div class="col-md-3">                
                                <listbox id="vlTipoDocumento" mold="select" class="form-select" 
                                    onChange="winEnvioEmail.filtrar()">
                                    <listitem value="" selected="true">
                                        <listcell label="Todos os tipos"/>
                                    </listitem>
                                    <listitem value="POP">
                                        <listcell label="POP"/>
                                    </listitem>
                                    <listitem value="IT">
                                        <listcell label="IT"/>
                                    </listitem>
                                    <listitem value="PR">
                                        <listcell label="PR"/>
                                    </listitem>
                                    <listitem value="PS">
                                        <listcell label="PS"/>
                                    </listitem>
                                    <listitem value="FORM">
                                        <listcell label="FORM"/>
                                    </listitem>
                                    <listitem value="REG">
                                        <listcell label="REG"/>
                                    </listitem>
                                    <listitem value="OUTROS">
                                        <listcell label="OUTROS"/>
                                    </listitem>
                                </listbox>
                            </div>
                            <div class="col-md-3">                
                                <listbox id="vlEstado" mold="select" class="form-select" 
                                    onChange="winEnvioEmail.filtrar()">
                                    <listitem value="" selected="true">
                                        <listcell label="Todos os estados"/>
                                    </listitem>
                                    <listitem value="ELABORACAO">
                                        <listcell label="Elaboração"/>
                                    </listitem>
                                    <listitem value="AVALIACAO">
                                        <listcell label="Avaliação"/>
                                    </listitem>
                                    <listitem value="SUGESTAO">
                                        <listcell label="Sugestão"/>
                                    </listitem>
                                    <listitem value="ASSINATURA">
                                        <listcell label="Assinatura"/>
                                    </listitem>
                                </listbox>
                            </div>
                        </div>
                    </div>
                    <div>
                        
                    </div>
                </div>

                <!-- Parte com o grid. Aqui definimos as colunas e como os dados serão mostrados. -->
                <div class="row responsive-grid-md"> 
                    <grid id="resultados" sizedByContent="false" mold="paging" width="100%" 
                        pageSize="10" emptyMessage="Nenhum documento encontrado">
                        <columns>
                            <column label="Código" sort="auto(cdDocumento)" width="8%"/>
                            <column label="Nome" sort="auto(nmDocumento)" width="32%"/>
                            <column label="Tipo" sort="auto(tpDocumento)" width="10%"/>
                            <column label="Data Criação" sort="auto(dtCriacao)" width="12%"/>
                            <column label="Estado" sort="auto(estado)" width="13%"/>
                            <column label="Diretoria" width="15%"/>
                            <column label="" width="120px"/>
                        </columns>
                        <template name="model">
                            <row onClick="winEnvioEmail.onClickedVerDocumento(event)" 
                                style="cursor: pointer;">
                                <attribute ca:name="id">${each.cdDocumento}</attribute>
                                <label value="${each.cdDocumento}"/>
                                <label value="${each.nmDocumento}"/>
                                <label value="${each.tpDocumento}"/>
                                <label value="${each.dtCriacao != null ? c:formatDate(each.dtCriacao, 'dd/MM/yyyy') : '-'}"/>
                                <label value="${each.estado != null ? each.estado.descricao : '-'}"/>
                                <label value="${each.diretoria != null ? each.diretoria.nmOrgao : '-'}"/>
                                <button label="Alterar" class="border-0 btn btn-outline-primary" 
                                    iconSclass="z-icon-pencil" 
                                    onClick="winEnvioEmail.onClickedAlterarDocumento(event)">
                                    <attribute ca:name="id">${each.cdDocumento}</attribute>
                                </button>
                            </row>
                        </template>
                    </grid>
                </div>
            </div>
        </div>

    </nodom>

</zk> 