<?xml version="1.0" encoding="UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul" xmlns:n="native" xmlns:w="client">
    <nodom title="" id="winRegra" use="controller.regras.RegraController">

        <div class="d-flex pb-4">
            <div class="col">
                <n:h4>Cadastro de Regra</n:h4>
            </div>
            <div class="col text-end">
                <button label="Voltar" iconSclass="z-icon-arrow-left"
                onClick="winRegra.voltar()" class="btn btn-secondary"/>
            </div>
        </div>

        <div class="card">
            <div class="card-body">

                <div class="row g-3">
                    <div class="col-md-12">
                        <label value="Código da Regra: "/>
                        <label id="cdRegra" value=""/>
                    </div>
                    <div class="col-md-12">
                        <label value="Nome"/>
                        <textbox id="nome" maxlength="150" class="form-control" placeholder="Insira o nome da regra"/>
                    </div>
                    <div class="col-md-6">
                        <label value="Gatilho"/>
                        <textbox id="deGatilho" maxlength="100" class="form-control" placeholder="Insira o gatilho de acionamento da regra"/>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-9">
                        <label value="Data de Início"/>
                        <datebox id="dtInicio" format="dd/MM/yyyy" width="150px"/>
                    </div>
                    <div class="col-md-9">
                        <label value="Data de Fim"/>
                        <datebox id="dtFim" format="dd/MM/yyyy" width="150px"/>
                    </div>
                    <div class="col-md-12">
                        <label value="Frequência"/>
                        <textbox id="deFrequencia" maxlength="50" class="form-control" placeholder="Insira a frequência de envio das mensagens"/>
                    </div>

                    <div class="d-flex">
                        <div class = "col-md-6">
                            <button class="btn btn-outline-danger" iconSclass="z-icon-trash" id="excluir" label="Excluir" onClick="winRegra.excluir()" visible="false"/>
                        </div>
                        <div class="col-md-6 text-end">
                            <button class="btn btn-secondary" iconSclass="" id="cancelar" label="Cancelar" onClick="winRegra.voltar()" visible="false"/>
                            <button class="btn btn-primary" iconSclass="z-icon-check" id="salvar" label="Salvar" onClick="winRegra.gravar()" visible="false"/>
                        </div>
                    </div>
                </div>

            </div>
        </div>

    </nodom>
</zk>