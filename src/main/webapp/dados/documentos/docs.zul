<?xml version="1.0" encoding="UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul" xmlns:n="native" xmlns:w="client" xmlns:ca="client/attribute">
    <nodom title="" id="winDocumentoList" use="controller.documentos.DocListController">
  
        <div class="d-flex pb-4">
            <div class="col">
                <n:h4>Cadastro de Documentos</n:h4>
            </div>
            <div class="col text-end">
                <button label="Novo Documento" iconSclass="z-icon-plus" 
                    onClick="winDocumentoList.novoDocumento()" class="btn btn-primary"/>
            </div>
        </div>
        
        <div class="card">
            <div class="card-body">

                <!-- Parte com botões. A classe justify-content-between fará com que os botões fiquem justificados -->
                <div class="d-flex justify-content-between form-group mb-3">
                    <div class="col-sm-10 col-md-10 col-lg-8 pl-0">
                        <div class="row"> 
                            <div class="col-md-4"> 
                                <div class="input-group">
                                    <textbox id="vlPesquisa" class="form-control" 
                                        placeholder="Buscar documentos...">
                                        <attribute name="onOK">
                                <![CDATA[
                                    winDocumentoList.filtrar();
                                ]]>
                                        </attribute>
                                    </textbox>        
                                    <button label="Filtrar" class="btn btn-light btn-outline-secondary" 
                                        iconSclass="z-icon-search" onClick="winDocumentoList.filtrar()"/>
                                </div>
                            </div>
                            <div class="col-md-4">                
                                <listbox id="vlCampo" mold="select" class="form-select">
                                    <listitem value="" selected="true">
                                        <listcell label="Todos os campos"/>
                                    </listitem>
                                    <listitem value="nome">
                                        <listcell label="Nome"/>
                                    </listitem>
                                    <listitem value="descricao">
                                        <listcell label="Descrição"/>
                                    </listitem>
                                    <listitem value="status_inicial">
                                        <listcell label="Status Inicial"/>
                                    </listitem>
                                    <listitem value="status_final">
                                        <listcell label="Status Final"/>
                                    </listitem>
                                </listbox>
                            </div>
                            <div class="col-md-4">                
                                <listbox id="vlTipoDocumento" mold="select" class="form-select" 
                                    onChange="winDocumentoList.filtrar()">
                                    <listitem value="" selected="true">
                                        <listcell label="Todos os tipos"/>
                                    </listitem>
                                    <listitem value="POP">
                                        <listcell label="POP - Procedimento Operacional Padrão"/>
                                    </listitem>
                                    <listitem value="IT">
                                        <listcell label="IT - Instrução de Trabalho"/>
                                    </listitem>
                                    <listitem value="PR">
                                        <listcell label="PR - Procedimento"/>
                                    </listitem>
                                    <listitem value="PS">
                                        <listcell label="PS - Protocolo de Serviço"/>
                                    </listitem>
                                    <listitem value="FORM">
                                        <listcell label="FORM - Formulário"/>
                                    </listitem>
                                    <listitem value="REG">
                                        <listcell label="REG - Regulamento"/>
                                    </listitem>
                                    <listitem value="OUTROS">
                                        <listcell label="OUTROS - Outros Tipos"/>
                                    </listitem>
                                </listbox>
                            </div>
                        </div>
                    </div>
                    <div>
                        
                    </div>
                </div>
        
                <!-- Parte com o grid. Aqui definimos as colunas e como os dados serão mostrados. -->
                <div class="row responsive-grid-md"> 
                    <grid id="resultados" sizedByContent="false" mold="paging" width="100%" 
                        pageSize="10" emptyMessage="Nenhum documento encontrado">
                        <columns>
                            <column label="Código" sort="auto(cdDocumento)" width="8%"/>
                            <column label="Nome" sort="auto(nmDocumento)" width="30%"/>
                            <column label="Tipo" sort="auto(tpDocumento)" width="12%"/>
                            <column label="Data Criação" sort="auto(dtCriacao)" width="12%"/>
                            <column label="Data Vencimento" sort="auto(dtVencimento)" width="13%"/>
                            <column label="Status" width="15%"/>
                            <column label="" width="120px"/>
                        </columns>
                        <template name="model">
                            <row onClick="winDocumentoList.onClickedVerDocumento(event)" 
                                style="cursor: pointer;">
                                <attribute ca:name="id">${each.cdDocumento}</attribute>
                                <label>${each.cdDocumento}</label>
                                <label>${each.nmDocumento}</label>
                                <label>${each.tpDocumento}</label>
                                <label>
                                    <attribute name="value">
                                        <![CDATA[
                                            ${each.dtCriacao != null ? 
                                            c:formatDate(each.dtCriacao, 'dd/MM/yyyy') : '-'}
                                        ]]>
                                    </attribute>
                                </label>
                                <label>
                                    <attribute name="value">
                                        <![CDATA[
                                            ${each.dtVencimento != null ? 
                                            c:formatDate(each.dtVencimento, 'dd/MM/yyyy') : '-'}
                                        ]]>
                                    </attribute>
                                </label>
                                <label>
                                    ${each.stInicial != null ? each.stInicial : '-'}
                                </label>
                                <button label="Alterar" class="border-0 btn btn-outline-primary" 
                                    iconSclass="z-icon-pencil" 
                                    onClick="winDocumentoList.onClickedAlterarDocumento(event)">
                                    <attribute ca:name="id">${each.cdDocumento}</attribute>
                                </button>
                            </row>
                        </template>
                    </grid>
                </div>
        
            </div>
        </div>
    </nodom>       
</zk>