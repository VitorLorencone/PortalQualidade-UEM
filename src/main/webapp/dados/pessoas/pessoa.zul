<?xml version="1.0" encoding="UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul" xmlns:n="native" xmlns:w="client">
    <nodom title="" id="winPessoa" use="controller.pessoas.PessoaController">
    
        <div class="d-flex pb-4">
            <div class="col">
                <n:h4>Cadastro de Pessoa</n:h4>
            </div>
            <div class="col text-end">
                <button label="Voltar" iconSclass="z-icon-arrow-left" onClick="winPessoa.voltar()" class="btn btn-secondary"/>
            </div>
        </div>
        
        <div class="card">
            <div class="card-body">

                <div class="row g-3"> 
                    <div class="col-md-12">
                        <label value="Código da Pessoa: "/>  
                        <label id="cdPessoa" value=""/> 
                    </div>
                    <div class="col-md-12">
                        <label value="Nome"/>  
                        <textbox id="nome" maxlength="150" class="form-control" placeholder="Insira o nome completo"/>
                    </div>
                    <div class="col-md-6">
                        <label value="Email"/>  
                        <textbox id="email" maxlength="100" class="form-control" placeholder="exemplo@email.com"/>           
                    </div>
                    <div class="col-md-6">
                        <label value="Celular" />  
                        <textbox id="celular" maxlength="20" class="form-control" placeholder="(11) 99999-9999"/>            
                    </div>

                    <div class="d-flex">
                        <div class="col-md-6">
                            <button class="btn btn-outline-danger" iconSclass="z-icon-trash" id="excluir" label="Excluir" onClick="winPessoa.excluir()" visible="false"/>
                        </div>
                        <div class="col-md-6 text-end">
                            <button class="btn btn-secondary" iconSclass="" id="cancelar" label="Cancelar" onClick="winPessoa.voltar()" visible="false"/>
                            <button class="btn btn-primary" iconSclass="z-icon-check" id="salvar" label="Salvar" onClick="winPessoa.gravar()" visible="false"/>
                        </div>
                    </div>
                </div>
        
            </div>
        </div>
 
    </nodom>       
</zk>