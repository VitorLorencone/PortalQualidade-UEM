<?xml version="1.0" encoding="UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul" xmlns:n="native" xmlns:w="client">
    <nodom title="" id="winOrgao" use="controller.orgaos.OrgaoController">
    
        <div class="d-flex pb-4">
            <div class="col">
                <n:h4>Cadastro de Órgão</n:h4>
            </div>
            <div class="col text-end">
                <button label="Voltar" iconSclass="z-icon-arrow-left" onClick="winOrgao.voltar()" class="btn btn-secondary"/>
            </div>
        </div>
        
        <div class="card">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-12">
                        <label value="Código do Órgão: "/> 	
                        <label id="cdOrgao" value="-1"/>
                    </div>
                    
                    <div class="col-md-12">
                        <label value="Tipo de Órgão"/> 	
                        <listbox id="tipoOrgao" mold="select" class="form-select" disabled="true">
                            <listitem value="generico_somente" selected="true">
                                <listcell label="Órgão Genérico"/>
                            </listitem>
                            <listitem value="diretoria">
                                <listcell label="Diretoria"/>
                            </listitem>
                            <listitem value="setor">
                                <listcell label="Setor"/>
                            </listitem>
                        </listbox>
                    </div>
                    
                    <div class="col-md-12">
                        <label value="Nome"/> 	
                        <textbox id="nome" maxlength="255" class="form-control" placeholder="Insira o nome do Órgão/Diretoria/Setor"/>
                    </div>
                    
                    <div class="d-flex">
                        <div class="col-md-6">
                            <button class="btn btn-outline-danger" iconSclass="z-icon-trash" id="excluir" label="Excluir" onClick="winOrgao.excluir()" visible="false"/>
                        </div>
                        <div class="col-md-6 text-end">
                            <button class="btn btn-secondary" iconSclass="" id="cancelar" label="Cancelar" onClick="winOrgao.voltar()" visible="false"/>
                            <button class="btn btn-primary" iconSclass="z-icon-check" id="salvar" label="Salvar" onClick="winOrgao.gravar()" visible="false"/>
                        </div>
                    </div>
                </div>
        
            </div>
        </div>
    
    </nodom> 	 	
</zk>