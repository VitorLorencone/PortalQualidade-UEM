<?xml version="1.0" encoding="UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul" xmlns:n="native" xmlns:w="client" xmlns:ca="client/attribute">
    <nodom id="winQrcode" use="exemplos.qrcode.controller.QrcodeController">
         
        <div class="d-flex pb-4">
            <div class="col">
                <n:h4>QRCode e Barcode e IdentIcon</n:h4>
            </div>
        </div>
        
        <div class="row ">
            <div class="col-md-12">
                Este é um exemplo de como gerar QRCode, Código de Barras e IdentIcon
            </div>
        </div>
        
        <!-- FUNCIONANDO -->
        
        <div class="card" >
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3">
                        <n:h5 class="">QRCode</n:h5>
                        <image id="img_qrcode"/>
                    </div>
                    <div class="col-md-3">    
                        <n:h5 class="mt-3">Barcode</n:h5>
                        <image id="img_barcode"/>
                    </div>
                    <div class="col-md-3">    
                        <n:h5 class="mt-3">Identicon Github Style</n:h5>
                        <image id="img_identicon_github" class="border"/>
                    </div>
                    <div class="col-md-3">    
                        <n:h5 class="mt-3">Identicon FirstLetters Style</n:h5>
                        <image id="img_identicon_firstletter" class="border"/>
                    </div>
                </div>
            </div>
        </div>

    </nodom>       
</zk>
