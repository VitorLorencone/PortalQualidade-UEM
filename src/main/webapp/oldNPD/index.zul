<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<!-- Ícones dos favoritos -->
<?link rel="shortcut icon" type="image/x-icon" href="../images/favicon.ico"?>
<?link rel="icon" type="image/x-icon" href="../images/favicon.ico"?>

<!-- CSS -->
<?link rel="stylesheet" type="text/css" href="../css/bootstrap.css"?>
<?link rel="stylesheet" type="text/css" href="../css/zkbootstrap.css"?>
<?link rel="stylesheet" type="text/css" href="../css/toastr.css"?>
<?link rel="stylesheet" type="text/css" href="../css/stepbar.css"?>
<?link rel="stylesheet" type="text/css" href="../css/jquery.bxslider.min.css"?>
<!--<?link rel="stylesheet" type="text/css" href="/css/fontawesome.css"?>-->

<!--
Alternativamente, você pode incluir o CSS do Bootstrap e o zkbootstrap usando os CDN abaixo
<?link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous"?>
<?link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/gh/alisonrafael/zkbootstrap@main/zkbootstrap.css"?>
-->

<zk xmlns="http://www.zkoss.org/2005/zul" xmlns:n="native" xmlns:w="client">
    
    <!--
    Exemplo de HEADER/CABEÇALHO
    -->
    <include src="header.zul"/>

    <!--
    Exemplos de MENU/NAVEGAÇÃO
    Aqui você tem o exemplo de três tipos de menu, um com html puro usando CSS e Javascript do Bootstrap (responsivo), 
    e os outros dois em ZK, sendo o Menubar e o Navbar (ambos tem sua versão vertical e horizontal porém não são responsivos).
    Você deverá escolher qual melhor se adapta à sua aplicação.
    Caso tenha alguma ideia de fazer algo diferente e precise de ajuda, falar com o Alison, que ele tem mais exemplos. 
    -->
    
    <!-- 
    Exemplo de menu horizontal usando o Navbar do Bootstrap e logo abaixo o "conteúdo" do sistema.
    Esse é o mais recomendado pois ele é responsivo.
    Sobre o funcionamento, consulte aqui https://getbootstrap.com/docs/5.3/components/navbar/#how-it-works
    Para manipular os elementos em Java (para o caso do menu ser dinâminco) haverá um pouco mais de trabalho.
    -->
    <include src="navbarbootstrap.zul"/>
    <div class="col p-3" style="min-height: calc(100vh - 195px) !important;">
        <include id="conteudo"/>
    </div>
    
    <!-- 
    Exemplo de menu horizontal usando Menubar do ZK e logo abaixo o "conteúdo" do sistema.
    Ele não é responsivo.
    Sobre o funcionamento, consulte aqui https://www.zkoss.org/zkdemo/menu/drop-down_menu
    Para manipular os elementos em Java (para o caso do menu ser dinâminco) será um pouco mais fácil, há exemplos de uso no NPD
    Este é o modelo mais usado nos sistemas legados.
    
    <include src="menubar.zul"/>
    <div class="col p-3" style="min-height: calc(100vh - 195px) !important;">
        <include id="conteudo"/>
    </div>
    -->
 
    <!-- 
    Exemplo de menu usano Navbar do ZK e ao lado do menu está o "conteúdo" do sistema.
    Ele não é responsivo.
    Sobre o funcionamento, consulte aqui https://www.zkoss.org/zkdemo/menu/navbar
    Para manipular os elementos em Java (para o caso do menu ser dinâminco) será um pouco mais fácil, mas não temos exemplo no NPD.
    Este é o modelo menos usado.
    
    <div class="container-fluid">
        <div class="row flex-nowrap" style="min-height: calc(100vh - 147px) !important;">
            <div class="col-auto col-xs-6 col-sm-3 col-md-3 col-lg-3 col-xl-2 p-0">
                <include src="navbar.zul"/>
            </div>
            <div class="col p-3">
                <include id="conteudo"/>
            </div>
        </div>
    </div>
    -->
        
    <!-- 
    Exemplo de FOOTER/RODAPÉ
    aqui tem um exemplo de footer, porém para o footer ficar no rodapé da página é necessário esticar o "conteúdo", 
    por isso tem o style "min-height: calc(100vh - 195px)" nas divs acima para que seja calculado 100% da altura menos o tamanho em pixel do header + do footer
    -->
    <include src="footer.zul"/>
 
    <!-- JS no final da página é muito importante -->
    <n:script type="text/javascript" src="../js/jquery.mask.js" defer="true"></n:script>
    <n:script type="text/javascript" src="../js/jquery.easing.1.3.js" defer="true"></n:script>
    <n:script type="text/javascript" src="../js/toastr.js" defer="true"></n:script>
    <n:script type="text/javascript" src="../js/bootstrap.js" defer="true"></n:script>
    <n:script type="text/javascript" src="../js/jquery.bxslider.min.js" defer="true"></n:script>

</zk>
