<?xml version="1.0" encoding="UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul" xmlns:n="native" xmlns:w="client" xmlns:ca="client/attribute">
    <div>

        <div class="d-flex">
            <div class="col">
                <n:h4>Componentes ZK com Bootstrap</n:h4>
            </div>
        </div>
        <div class="row pb-4">
            <div class="col-12">
                Exemplos de componentes ZK com estilos do Bootstrap. Esta página também é um exemplo de como montar um layout responsivo com Bootstrap.
            </div>
        </div>
        
        <!-- 
            Como montar um Layout responsivo? 
            O que você precisa saber para layout responsivo com Boostrap é o sistema de "grid" do Bootstrap.
            A divisão da tela é em 12 "colunas" onde você define para cada div quantas colunas ela irá ocupar para cada tamanho de tela,
            sendo que os tamanhos de telas são small (sm), medium (md), large (lg).
            Tem alguns exemplo no fim da página. Explicação desse sistema de grid do Bootstrap você encontra aqui: https://getbootstrap.com/docs/5.3/layout/grid/
        -->
        
        <div class="row gy-4"> 
            
            <!-- 
                Os componentes Textbox, Intbox e Doublebox precisam da classe "form-control" 
                Mais detalhes aqui https://www.zkoss.org/zkdemo/getting_started/input e aqui https://www.zkoss.org/zkdemo/input?search=input
            -->
            <div class="col-sm-6 col-md-4 col-lg-4">
                <n:h5>Textbox</n:h5>
                <textbox maxlength="40" class="form-control"/>
            </div>
            <div class="col-sm-6 col-md-4 col-lg-2">
                <n:h5>Intbox</n:h5>
                <intbox  maxlength="4" cols="4" class="form-control"/> 
            </div>
            <div class="col-sm-6 col-md-4 col-lg-2">
                <n:h5>Doublebox</n:h5>
                <doublebox  maxlength="6" cols="6" class="form-control"/> 
            </div>
            
            <!-- 
                O componente Datebox para selecionar datas 
                Mais detalhes aqui https://www.zkoss.org/zkdemo/input/date_and_time_picker
            -->
            <div class="col-sm-6 col-md-3 col-lg-2">
                <n:h5>Datebox</n:h5>
                <datebox timeZone="GMT-3" locale="pt_BR" format="dd/MM/yyyy" class="form-control"/>
            </div>
            
            <div class="col-sm-6 col-md-3 col-lg-2">
                <n:h5>Timebox</n:h5>
                <timebox timeZone="GMT-3" locale="pt_BR" cols="8" format="HH:mm:ss" class="form-control"/>
            </div>
            
            <!-- 
                O componente Chosenbox é uma alternativa ao Listbox para seleção múltipla 
                Mais detalhes aqui https://www.zkoss.org/wiki/ZK_Component_Reference/Input/Chosenbox 
            -->
            <div class="col-sm-6 col-md-6 col-lg-4">
                <n:h5>Chosenbox</n:h5>
                <zscript>
                    ListModelList listaLocales = new ListModelList(Locale.getAvailableLocales());
                </zscript>
                <chosenbox class="form-control" creatable="false" model="${listaLocales}"
                               emptyMessage="Nenhum item selecionado" 
                               noResultsText="Nenhum item '{0}' encontrado."
                               createMessage="Nenhum item '{0}' encontrado, porém ao adicionar você irá criá-lo.">
                    <attribute name="onSearch">
                        Object obj = event.getValue();
                        ((ListModelList)listaLocales).add(obj);
                        self.addItemToSelection(obj);
                    </attribute>
                </chosenbox>
            </div>
            
            <!-- 
                O Input-Group é um Textbox com Button integrado, é um recurso visual interessante que o Bootstrap oferece.
                Mais detalhes de como montar input-groups aqui https://getbootstrap.com/docs/5.3/forms/input-group/
            -->
            <div class="col-sm-6 col-md-6 col-lg-4">
                <n:h5>Input Group</n:h5>
                <div class="input-group">
                    <textbox id="vlPesquisa"  class="form-control">
                        <attribute name="onOK">
                            //colocar aqui a mesma coisa que o onClick do button abaixo
                        </attribute>
                    </textbox>        
                    <button label="" class="btn btn-outline-secondary" iconSclass="z-icon-search" onClick=""/>
                </div>
            </div>
       
            <!-- 
                O componente Listbox precisa da classe "form-select" 
                Mais detalhes o Listbox aqui https://www.zkoss.org/zkdemo/getting_started/listbox e aqui https://www.zkoss.org/zkdemo/listbox
            -->
            <div class="col-sm-6 col-md-6 col-lg-4">
                <n:h5>Listbox</n:h5>
                <listbox mold="select" class="form-select">
                    <listitem value="" selected="true">
                        <listcell label="Selecione"/>
                    </listitem>
                    <listitem value="1">
                        <listcell label="Opção 1"/>
                    </listitem>
                    <listitem value="2">
                        <listcell label="Opção 2"/>
                    </listitem>
                    <listitem value="3">
                        <listcell label="Opção 3"/>
                    </listitem>
                </listbox>
            </div>
            
            <!-- 
                O componente Radio permite apenas um item selecionado por vez 
                Mais detalhes aqui https://www.zkoss.org/zkdemo/input/radio_button
            -->
            <div class="col-sm-6 col-md-4 col-lg-4">
                <n:h5>Radio</n:h5>
                <radiogroup>
                    <radio label="Item 1" selected="true"/>
                    <radio label="Item 2"/>
                    <radio label="Item 3"/>
                </radiogroup>
            </div>
            
            <!-- 
                O componente Checkbox permite múltiplos itens selecionados por vez. Ele tem em versão "switch".
                Mais detalhes aqui https://www.zkoss.org/zkdemo/input/checkbox
            -->
            <style>
                .checkboxred input[type="checkbox"]:checked {
                background-color: #dc3545!important;
                }

                .checkboxred input[type="checkbox"]:checked:before {
                content: "\f00d";
                }
            </style>
            <div class="col-sm-6 col-md-8 col-lg-8">
                <n:h5>Checkbox</n:h5>
                <checkbox id="1" label="Item 1" />
                <checkbox id="2" label="Item 2" checked="true"/>
                <checkbox class="checkboxred" id="3" label="Item 3 (customizado)"  checked="true"/>
                <checkbox mold="switch" label="Item 4 (switch)"/>
            </div>

            <!--
                CKEditor (https://ckeditor.com) é um editor WYSIWYG para ZK (https://www.zkoss.org/wiki/ZK_Component_Reference/Input/CKEditor)
                Utilizado para formatar o texto (cores, negrito, itálico, etc.) e pegar o html gerado, para usar em campos de
                envio de e-mail, message chats, etc.
                Veja um exemplo na tela de envio de e-mail.
                Repare que é necessário ter o /js/ckeditor.js para funcionar.
            -->
            <div class="col-sm-12 col-md-6">
                <n:h5>CKEditor (Editor HTML) </n:h5>
                <ckeditor id="editor_html" customConfigurationsPath="/js/ckeditor.js" width="400" height="100"/>
            </div>
            
            <!-- 
                Ace Editor para ZK. Editor de código-fonte SQL, Java, PHP, etc.
                Para ver opções de "theme" e "mode" ver em https://ace.c9.io/build/kitchen-sink.html
                Existe uma biblioteca no pom.xml necessária para funcionar.
            -->
            <div class="col-sm-12 col-md-6">
                <n:h5>ACE Editor (Editor de código-fonte) </n:h5>
                <aceditor id="aceditor" mode="sql" theme="github" width="400px" height="200px" value="SELECT * FROM SCHEMA.TABELA"></aceditor>
            </div>
            
            <!-- 
                Mais sobre como personalizar links aqui https://getbootstrap.com/docs/5.3/helpers/colored-links/ 
            -->
            <div class="col-md-12">
                <n:h5 class="mt-3">Links</n:h5>
                <a href="" class="link-underline link-underline-opacity-0 link-underline-opacity-75-hover">Link Underline</a>
                <a href="" class="text-decoration-none">Link Sem Underline</a>
                <a href="" class="link-primary">Link Primary</a>
                <a href="" class="link-secondary">Link Secondary</a>
                <a href="" class="link-success">Link Success</a>
                <a href="" class="link-warning">Link Warnig</a>
                <a href="" class="link-danger">Link Danger</a>
                <a href="" class="link-info">Link Info</a>
            </div>
            
            <!-- 
                O componente Button precisa da classe "btn", e com a classe adicional "btn-XXX" você determina a cor e/ou o tamanho 
                Mais detalhes do Button do ZK aqui https://www.zkoss.org/zkdemo/input/button
                Mais detalhes de como personalizar com Boostrap aqui https://getbootstrap.com/docs/5.3/components/buttons/
            -->
            <div class="col-md-12">
                <n:h5 class="mt-3">Buttons</n:h5>
                <button label="Primary" class="btn btn-primary"/>
                <button label="Secondary" class="btn btn-secondary"/>
                <button label="Success" class="btn btn-success"/>
                <button label="Danger" class="btn btn-danger"/>
                <button label="Warning" class="btn btn-warning"/>
                <button label="Info" class="btn btn-info"/>
                <button label="Light" class="btn btn-light"/>
                <button label="Dark" class="btn btn-dark"/>
                <button label="Link" class="btn btn-link"/>
                
                <button label="Primary" class="btn btn-outline-primary"/>
                <button label="Secondary" class="btn btn-outline-secondary"/>
                <button label="Success" class="btn btn-outline-success"/>
                <button label="Danger" class="btn btn-outline-danger"/>
                <button label="Warning" class="btn btn-outline-warning"/>
                <button label="Info" class="btn btn-outline-info"/>
                <button label="Light" class="btn btn-outline-light"/>
                <button label="Dark" class="btn btn-outline-dark"/>
                
                <button label="Large" class="btn btn-primary btn-lg"/>
                <button label="Small" class="btn btn-primary btn-sm"/>
                
                <div class="btn-group" >
                    <button class="btn btn-outline-primary">Esquerda</button>
                    <button class="btn btn-outline-primary">Meio</button>
                    <button class="btn btn-outline-primary">Direita</button>
                </div>
            </div>
            
            <!-- 
                Tabbox do ZK, mais detalhes aqui https://www.zkoss.org/zkdemo/tabbox
            -->
            <div class="col-md-12">
                <n:h5 class="mt-3">Tabbox</n:h5>
                <tabbox id="tabbox">
                    <tabs id="tabs" class="card-header card-header-tab-animation">
                        <tab id="tab_1" label="Tab 1"/>
                        <tab id="tab_2" label="Tab 2"/>
                        <tab id="tab_3" label="Tab 3"/>
                        <tab id="tab_4" label="Tab 4"/>
                        <tab id="tab_5" label="Tab 5"/>
                    </tabs>
                    <tabpanels>
                        <tabpanel>
                            Conteúdo da Tab 1
                        </tabpanel>
                        <tabpanel>
                            Conteúdo da Tab 2
                        </tabpanel>
                        <tabpanel>
                            Conteúdo da Tab 3
                        </tabpanel>
                        <tabpanel>
                            Conteúdo da Tab 4
                        </tabpanel>
                        <tabpanel>
                            Conteúdo da Tab 5
                        </tabpanel>
                    </tabpanels>
                </tabbox>
            </div>
            
            <!-- 
                O componente grid do zk já esta costumizado com css do bootstrap e não precisa de classes adicionais
                Mais detalhes aqui https://www.zkoss.org/zkdemo/getting_started/grid e aqui https://www.zkoss.org/zkdemo/grid
            -->
            <div class="col-md-12">
                <n:h5 class="mt-3">Grid (tables)</n:h5>
                <!-- é importante colocar o grid dentro desta div com a classe "responsive-grid-md" para que apareça a barra de rolagem horizontal em telas pequenas -->
                <div class="responsive-grid-md"> 
                    <grid sizedByContent="false" mold="paging" width="100%" pageSize="4" emptyMessage="Nenhum dado encontrado">
                        <columns>
                            <column label="Coluna 1" sort="auto"/>
                            <column label="Coluna 2" sort="auto"/>
                            <column label="Coluna 3" sort="auto"/>
                            <column label="Coluna 4" sort="auto"/>
                            <column label="Coluna 5" sort="auto"/>
                        </columns>
                        <!-- as linhas podem ser coloridas, para mais cores consulte em https://getbootstrap.com/docs/5.3/utilities/background/#background-color -->
                        <rows>
                            <row class="bg-info-subtle">
                                <label value="Valor A1" class="table-primary"/>
                                <label value="Valor A2" />
                                <label value="Valor A3" />
                                <label value="Valor A4" />
                                <label value="Valor A5" /> 
                            </row>
                            <row >
                                <label value="Valor B1" />
                                <label value="Valor B2" />
                                <label value="Valor B3" />
                                <label value="Valor B4" />
                                <label value="Valor B5" /> 
                            </row>
                            <row class="bg-success-subtle">
                                <label value="Valor C1" />
                                <label value="Valor C2" />
                                <label value="Valor C3" />
                                <label value="Valor C4" />
                                <label value="Valor C5" /> 
                            </row>
                            <row>
                                <label value="Valor D1" />
                                <label value="Valor D2" />
                                <label value="Valor D3" />
                                <label value="Valor D4" />
                                <label value="Valor D5" /> 
                            </row>
                            <row>
                                <label value="Valor E1" />
                                <label value="Valor E2" />
                                <label value="Valor E3" />
                                <label value="Valor E4" />
                                <label value="Valor E5" /> 
                            </row>
                            <row class="bg-warning-subtle">
                                <label value="Valor F1" />
                                <label value="Valor F2" />
                                <label value="Valor F3" />
                                <label value="Valor F4" />
                                <label value="Valor F5" /> 
                            </row>
                            <row>
                                <label value="Valor G1" />
                                <label value="Valor G2" />
                                <label value="Valor G3" />
                                <label value="Valor G4" />
                                <label value="Valor G5" /> 
                            </row>
                            <row class="bg-danger-subtle">
                                <label value="Valor H1" />
                                <label value="Valor H2" />
                                <label value="Valor H3" />
                                <label value="Valor H4" />
                                <label value="Valor H5" /> 
                            </row>
                            <row>
                                <label value="Valor I1" />
                                <label value="Valor I2" />
                                <label value="Valor I3" />
                                <label value="Valor I4" />
                                <label value="Valor I5" /> 
                            </row>
                            <row>
                                <label value="Valor J1" />
                                <label value="Valor J2" />
                                <label value="Valor J3" />
                                <label value="Valor J4" />
                                <label value="Valor J5" /> 
                            </row>
                            <row>
                                <label value="Valor K1" />
                                <label value="Valor K2" />
                                <label value="Valor K3" />
                                <label value="Valor K4" />
                                <label value="Valor K5" /> 
                            </row>
                            <row>
                                <label value="Valor L1" />
                                <label value="Valor L2" />
                                <label value="Valor L3" />
                                <label value="Valor L4" />
                                <label value="Valor L5" /> 
                            </row>
                            <row>
                                <label value="Valor M1" />
                                <label value="Valor M2" />
                                <label value="Valor M3" />
                                <label value="Valor M4" />
                                <label value="Valor M5" /> 
                            </row>
                            <row>
                                <label value="Valor N1" />
                                <label value="Valor N2" />
                                <label value="Valor N3" />
                                <label value="Valor N4" />
                                <label value="Valor N5" /> 
                            </row>
                        </rows>
                    </grid>
                </div>
            </div>
            
            <!--
                Notificações do tipo Clients.showNotification é bom para informar erros em determinados compoenentes.
                Caso você tenha um controller atrelado ao zul, você deve trocar o "self" por "this.nomeDoCompoenente".
                Notificações do tipo Toast é interessante para informar coisas que não precisa de ação do usuário, por 
                exemplo, dizer que os dados foram alterados com sucesso. 
                Notificações do tipo Messabox é interessante para informar coisas que precisa de muita atenção do usuário, 
                forçando ele clicar em OK, por exemplo, informar algo muito importante que necessita que a mensagem 
                seja lida com atenção.
                Notificação tipo Alert é uma alternativa ao Toast com a mesma vantagem do Messagebox. 
                A dificuldade de usar é que tem que criar uma div e sempre deixar essa div no código onde irá aparecer a mensagem,
                além de que esse componente é puro html/css do Bootstrap, não tendo um recurso Java com ZK para manipular o elemento.
            -->
            <div class="col-md-12">
                <n:h5 class="mt-3">Notificações no Componente <span class="fw-lighter">(clique para ver)</span></n:h5> 
                <zscript>
                    import org.zkoss.zk.ui.util.Clients;
                </zscript>
                <button label="Notificação Info" class="btn btn-success">
                    <attribute name="onClick">
                        Clients.showNotification("Esta é uma notificação de informação no componente", Clients.NOTIFICATION_TYPE_INFO, self, "end_center", 0);
                    </attribute>
                </button>
                <button label="Notificação Warning" class="btn btn-warning">
                    <attribute name="onClick">
                        Clients.showNotification("Esta é uma notificação de alerta no componente", Clients.NOTIFICATION_TYPE_WARNING, self, "end_center", 0);
                    </attribute>
                </button>
                <button label="Notificação Error" class="btn btn-danger">
                    <attribute name="onClick">
                        Clients.showNotification("Esta é uma notificação de erro no componente", Clients.NOTIFICATION_TYPE_ERROR, self, "end_center", 0);
                    </attribute>
                </button>
            </div>
            
            <div class="col-md-12">
                <n:h5 class="mt-3">Notificações Toast <span class="fw-lighter">(clique para ver)</span></n:h5>
                <zscript>
                    import zk.custom.Toast;
                </zscript>
                <button label="Toast Success" class="btn btn-success">
                    <attribute name="onClick">
                        Toast.show("Este é um Toast de sucesso", "Sucesso", Toast.Type.SUCCESS);
                    </attribute>
                </button>
                <button label="Toast Info" class="btn btn-info">
                    <attribute name="onClick">
                        Toast.show("Este é um Toast de informação", "Sucesso", Toast.Type.INFO);
                    </attribute>
                </button>
                <button label="Toast Warning" class="btn btn-warning">
                    <attribute name="onClick">
                        Toast.show("Este é um Toast de alerta", "Sucesso", Toast.Type.WARNING);
                    </attribute>
                </button>
                <button label="Toast Error" class="btn btn-danger">
                    <attribute name="onClick">
                        Toast.show("Este é um Toast de erro", "Sucesso", Toast.Type.ERROR);
                    </attribute>
                </button>
            </div>
            
            <div class="col-md-12">
                <n:h5 class="mt-3">Messabox <span class="fw-lighter">(clique para ver)</span></n:h5>
                <zscript>
                    import utilitarios.ZkUtils;
                    ZkUtils zkUtils = new ZkUtils();
                </zscript>
                <button label="Messagebox de Confirmação" class="btn btn-primary">
                    <attribute name="onClick">
                        if (zkUtils.MensagemConfirmacao("Confirma executar a ação?")) {
                        zkUtils.Mensagem("Você confirmou!");ã
                        } else {
                        zkUtils.Mensagem("Você NÃO confirmou!");
                        }
                    </attribute>
                </button>
                <button label="Messagebox Info" class="btn btn-info">
                    <attribute name="onClick">
                        zkUtils.Mensagem("Esta é uma mensagem de informação!");
                    </attribute>
                </button>
                <button label="Messagebox Warning" class="btn btn-warning">
                    <attribute name="onClick">
                        zkUtils.MensagemAtencao("Esta é uma mensagem de atenção!");
                    </attribute>
                </button>
                <button label="Messagebox Error" class="btn btn-danger">
                    <attribute name="onClick">
                        zkUtils.MensagemErro("Esta é uma mensagem de erro!");
                    </attribute>
                </button>
            </div>
            
            <div class="col-md-12">
                <n:h5 class="mt-3">Alerts  <span class="fw-lighter">(clique para ver)</span></n:h5>
                <div id="alert_primary" class="alert alert-primary alert-dismissible fade show" visible="false">
                    Um alerta primário simples e com botão de fechar – confira!
                    <button type="button" class="btn-close" onClick="alert_primary.setVisible(false)"></button>
                </div>
                <div id="alert_secondary" class="alert alert-secondary alert-dismissible fade show" visible="false">
                    Um alerta primário simples – confira!
                </div>
                <div id="alert_info" class="alert alert-info alert-dismissible fade show" visible="false">
                    Um alerta primário simples – confira!
                </div>
                <div id="alert_success" class="alert alert-success alert-dismissible fade show" visible="false">
                    Um alerta primário simples – confira!
                </div>
                <div id="alert_warning" class="alert alert-warning alert-dismissible fade show" visible="false">
                    Um alerta primário simples – confira!
                </div>
                <div id="alert_danger" class="alert alert-danger alert-dismissible fade show" visible="false">
                    Um alerta primário simples – confira!
                </div>
                <div id="alert_light" class="alert alert-light alert-dismissible fade show" visible="false">
                    Um alerta primário simples – confira!
                </div>
                <div id="alert_dark" class="alert alert-dark alert-dismissible fade show" visible="false">
                    Um alerta primário simples – confira!
                </div>
                <button label="Alert Primary" class="btn btn-primary" onClick=" alert_primary.setVisible(!alert_primary.isVisible());"/>
                <button label="Alert Secondary" class="btn btn-secondary" onClick="alert_secondary.setVisible(!alert_secondary.isVisible());"/>
                <button label="Alert Info" class="btn btn-info" onClick="alert_info.setVisible(!alert_info.isVisible());"/>
                <button label="Alert Success" class="btn btn-success" onClick="alert_success.setVisible(!alert_success.isVisible());"/>
                <button label="Alert Warning" class="btn btn-warning" onClick="alert_warning.setVisible(!alert_warning.isVisible());"/>
                <button label="Alert Danger" class="btn btn-danger" onClick="alert_danger.setVisible(!alert_danger.isVisible());"/>
                <button label="Alert Light" class="btn btn-light" onClick="alert_light.setVisible(!alert_light.isVisible());"/>
                <button label="Alert Dark" class="btn btn-dark" onClick="alert_dark.setVisible(!alert_dark.isVisible());"/>
            </div>
            
            <!-- 
                O Tooltip é aparece quando ocorre o evento onMouseOver e desaparece em 0,5 segundo após o cursor se afastar. 
                A pop-up aparece em um evento onClick e desaparece quando perde o foco. 
                Mais detalhes aqui https://www.zkoss.org/zkdemo/popup/pop-ups
            -->
            <div class="col-md-12">
                <n:h5 class="mt-3">Pop-up / Tooltip</n:h5>
                <label value="Passe o cursor sobre mim!" tooltip="popup" />
                <separator/>
                <label value="Clique em mim!" popup="popup" />
                <separator/>
                <button class="btn p-0" iconSclass="z-icon-question-circle-o" popup="popup" tooltip="popup" style="cursor: help"></button>
                <popup id="popup">
                    Este é um exemplo de Pop-up ou Tooltip feito em ZK. 
                    <separator/>
                    Mais informações dos componentes ZK <a label="clique aqui" target="zkdemo" href="https://www.zkoss.org/zkdemo/"/>.
                </popup>
            </div>
            
            <!-- 
                Barra de progresso
                Podemos utilizar a barra de progresso em html puro com bootstrap (primeiro dois exemplos),
                ou utilizar a barra de progresso do ZK (último exemplo). Recomento utilizar a barra do ZK 
                será mais fácil de manipular em Java.
                Mais detalhes aqui https://www.zkoss.org/zkdemo/miscellaneous/progress_meter
            -->
            <div class="col-md-12">
                <n:h5 class="mt-3">Progress Bar</n:h5>
                <n:div class='progress' >
                    <n:div class='progress-bar' role='progressbar' style='width: 25%;' aria-valuenow='25' aria-valuemin='0' aria-valuemax='100'>25%</n:div>
                </n:div>
                <div class="pt-3"></div>
                <n:div class='progress' >
                    <n:div class='progress-bar progress-bar-striped bg-info progress-bar-animated' role='progressbar' style='width: 25%;' aria-valuenow='25' aria-valuemin='0' aria-valuemax='100'>25%</n:div>
                </n:div>
                <div class="pt-3"></div>
                <div>
                    <progressmeter id="progress_meter" value="25" width="100%"/>
                </div>
            </div>
            
            <!-- 
                StepBar customizado, pois o ZK não tem esse componente de graça
                É possível pegar o componente no Java e alterar o step atual dele por meio do método setStep(),
                assim como alterar os valores dos subtitles e o número de passos.
            -->
            <div class="col-md-12">
                <n:h5 class="mt-3">Stepbar <span class="fw-lighter">(clique para ver)</span></n:h5>
                <stepbar id="stepbar" step="1" size="4" subtitles="Passo 1,Passo 2,Passo 3,Passo 4">
                    <attribute name="onClick">
                        self.next();
                    </attribute>
                </stepbar>
            </div>
            
            <!-- 
                Navbar do Bootstrap 
                Este elemento é feito em html "puro" com as classes CSS e Javascript do Bootstrap.
                Desse modo, é importante a utilização do prefixo "n:" antes das tags html, para poder dizer para o ZK ignorar essas tags e
                processar como html "puro", pois são tag "nativas" do html.
                Este Navbar é melhor que o menubar ou navbar do ZK, pois é responsivo.
            -->
            <div class="col-md-12">
                <n:h5 class="mt-3">Navbar</n:h5>
                <n:nav class="navbar navbar-expand-lg navbar-light bg-light border bg-white">
                    <div class="container-fluid">
                        <n:a class="navbar-brand" href="">
                            <n:img src="images/uem50anos.png" alt="UEM" title="UEM 50 Anos" class="d-inline-block align-text-top" style="height:23px;"/>
                            Menu
                        </n:a>
                        <n:button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                            <n:span class="navbar-toggler-icon"></n:span>
                        </n:button>
                        <n:div class="collapse navbar-collapse" id="navbarSupportedContent">
                            <n:ul class="navbar-nav me-auto mb-2 mb-lg-0">
                                <n:li class="nav-item">
                                    <a class="nav-link" href="">Item 1</a>
                                </n:li>
                                <n:li class="nav-item">
                                    <a class="nav-link" href="">Item 2</a>
                                </n:li>
                                <n:li class="nav-item">
                                    <a class="nav-link" href="">Item 3</a>
                                </n:li>
                                <n:li class="nav-item dropdown">
                                    <n:a class="nav-link dropdown-toggle" href="" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Dropdown
                                    </n:a>
                                    <n:ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                                        <n:li>
                                            <a class="dropdown-item" href="">Item 4</a>
                                        </n:li>
                                        <n:li>
                                            <a class="dropdown-item" href="">Item 5</a>
                                        </n:li>
                                        <n:li>
                                            <n:hr class="dropdown-divider"/>
                                        </n:li>
                                        <n:li>
                                            <a class="dropdown-item" href="">Item 6</a>
                                        </n:li>
                                    </n:ul>
                                </n:li>
                                <n:li class="nav-item">
                                    <a class="nav-link" href="" disabled="true">Item 7</a>
                                </n:li>
                            </n:ul>
                            <n:form class="d-flex">
                                <button class="btn btn-outline-secondary">Botão</button>
                            </n:form>
                        </n:div>
                    </div>
                </n:nav>
            </div>
            
