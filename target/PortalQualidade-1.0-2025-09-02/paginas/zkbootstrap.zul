                        <div class="col-md-6">col-md-6</div>
                    </div>
                    <div class="row">
                        <div class="col-md-8">col-md-8</div>
                        <div class="col-md-4">col-md-4</div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">col-md-12</div>
                    </div>
                    <div class="row">
                        <div class="col-sm-12 col-md-6 col-lg-3">col-sm-12 col-md-6 col-lg-2</div>
                    </div>
                    <div class="row">
                        <div class="col-md-4">col-md-4</div>
