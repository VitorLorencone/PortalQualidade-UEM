            <!-- 
                Mais detalhes de Cards em https://getbootstrap.com/docs/5.3/components/card/ 
            -->
            <div class="col-md-12">
                <n:h5 class="mt-3">Cards</n:h5>
                <div class="row">
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body">
                                <n:h5 class="card-title">Título</n:h5>
                                <n:h6 class="card-subtitle mb-2 text-body-secondary">Subtítulo</n:h6>
                                <n:p class="card-text">Algum texto de exemplo rápido para construir sobre o título do cartão e compor a maior parte do conteúdo do cartão.</n:p>
                                <button href="" class="btn btn-primary">Executar</button>
                                <a class="card-subtitle mb-2">Link para ir</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card text-center">
                            <div class="card-header">
                                Destaque
                            </div>
                            <div class="card-body">
                                <n:h5 class="card-title">Tratamento especial do título</n:h5>
                                <n:p class="card-text">Com texto de suporte abaixo como uma introdução natural a conteúdo adicional.</n:p>
                                <button href="" class="btn btn-primary">Botão</button>
                            </div>
                            <div class="card-footer text-body-secondary">
                                Rodapé
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- 
                Mais detalhes de tipos de sombras em https://getbootstrap.com/docs/5.3/utilities/shadows/ 
            -->
            <div class="col-md-12">
                <n:h5 class="mt-3" >Sombras</n:h5>
                <div class="row">
                    <div class="col-2">
                        <div class="shadow-none p-3 bg-body-tertiary">Sem sombra</div>
                    </div>
                    <div class="col-2">
                        <div class="shadow-sm p-3 bg-body-tertiary" >Sombra Small</div>
                    </div>
                    <div class="col-2">
                        <div class="shadow p-3 bg-body-tertiary" >Sombra Padrão</div>
                    </div>
                    <div class="col-2">
                        <div class="shadow-lg p-3 bg-body-tertiary" >Sombra Larger</div>
                    </div>
                </div>
            </div>
            
            <!-- 
                Mais detalhes de tipos de bordas em https://getbootstrap.com/docs/5.3/utilities/borders/ 
            -->
            <div class="col-md-12">
                <n:h5 class="mt-3">Bordas</n:h5>
                <div class="row">
                    <div class="col-1">
                        <div class="border p-3 bg-body-tertiary">Borda padrão</div>
                    </div>
                    <div class="col-1">
                        <div class="border border-primary p-3 bg-body-tertiary">Borda primary</div>
                    </div>
                    <div class="col-1">
                        <div class="border border-warning p-3 bg-body-tertiary">Borda warning</div>
                    </div>
                    <div class="col-1">
                        <div class="border border-danger p-3 bg-body-tertiary">Borda danger</div>
                    </div>
                    <div class="col-1">
                        <div class="border border-dark p-3 bg-body-tertiary">Borda dark</div>
                    </div>
                    <div class="col-1">
                        <div class="border border-1 p-3 bg-body-tertiary">Borda grossura nível 1</div>
                    </div>
                    <div class="col-1">
                        <div class="border border-5 p-3 bg-body-tertiary">Borda grossura nível 5</div>
                    </div>
                    <div class="col-1">
                        <div class="border rounded p-3 bg-body-tertiary">Borda arredondado nível 1</div>
                    </div>
                    <div class="col-1">
                        <div class="border rounded-5 p-3 bg-body-tertiary">Borda arredondado nível 5</div>
                    </div>
                    <div class="col-1">
                        <div class="border-start border-bottom p-3 bg-body-tertiary">Borda em dois lados apenas</div>
                    </div>
                </div>
            </div>
            
            <!-- 
                Mais detalhes de Badges em https://getbootstrap.com/docs/5.3/components/badge/ 
            -->
            <div class="col-md-12">
                <n:h5 class="mt-3">Badges</n:h5>
                <div class="col">
                    <span class="badge text-bg-primary">Primary</span>
                    <span class="badge text-bg-secondary">Secondary</span>
                    <span class="badge text-bg-success">Success</span>
                    <span class="badge text-bg-danger">Danger</span>
                    <span class="badge text-bg-warning">Warning</span>
                    <span class="badge text-bg-info">Info</span>
                    <span class="badge text-bg-light">Light</span>
                    <span class="badge text-bg-dark">Dark</span>  
                    <span class="badge rounded-pill text-bg-primary">Primary</span>
                    <span class="badge rounded-pill text-bg-secondary">Secondary</span>
                    <span class="badge rounded-pill text-bg-success">Success</span>
                    <span class="badge rounded-pill text-bg-danger">Danger</span>
