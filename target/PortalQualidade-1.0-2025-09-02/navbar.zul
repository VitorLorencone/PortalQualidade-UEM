<zk xmlns="http://www.zkoss.org/2005/zul" xmlns:n="native" xmlns:w="client">
    
    <nodom id="winMenu" use="menu.controller.MenuController">   
        
        <navbar id="navbar" orient="vertical" collapsed="false" sclass="border-0 p-0 shadow-sm">
            <nav label="Cadastros" iconSclass="z-icon-book">
                <navitem label="Curso" onClick="winMenu.abrirCurso()"/>
                <navitem label="Inscrição" onClick="winMenu.abrirInscricao()"/>
            </nav>

            <navitem label="Endereço" iconSclass="z-icon-address-card" onClick="winMenu.abrirEndereco()"/>

            <nav label="Relatórios" iconSclass="z-icon-file-text" badgeText="3">
                <navitem label="Lista Cursos"  onClick="winMenu.abrirCursoRelatorio()"/>
            </nav>

            <navitem label="Login" iconSclass="z-icon-user" onClick="winMenu.abrirLogin()" />
        </navbar>
        
    </nodom>
    
</zk>